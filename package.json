{
  "name": "gina-training-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "scripts": {
    "dev": "node --import tsx server.ts",
    "predev": "node scripts/package-source.mjs",
    "prebuild": "node scripts/package-source.mjs",
    "build": "vite build",
    "start": "NODE_ENV=production node --import tsx server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:challenges": "node --import tsx scripts/run-challenges.ts",
    "test:local": "node --import tsx --test scripts/*.test.mjs",
    "pretest": "node scripts/package-source.mjs",
    "test": "node --import tsx scripts/run-challenges.ts && node --import tsx --test scripts/*.test.mjs",
    "package:source": "node scripts/package-source.mjs",
    "playground": "node --import tsx scripts/playground.ts",
    "scan": "node scripts/scan-injection.mjs",
    "crm:queue": "node --import tsx scripts/crm-csv-queue.mjs",
    "agent:report": "node scripts/agent-test-report.mjs",
    "sf:env": "node scripts/salesforce-env.mjs",
    "sf:seed": "node --import tsx scripts/salesforce-seed.mjs",
    "build:showcase": "vite build --config vite.showcase.config.ts",
    "preview:showcase": "vite preview --config vite.showcase.config.ts --open /showcase.html",
    "og:render": "node scripts/render-og.mjs"
  },
  "engines": {
    "node": "24.21.0"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vercel/analytics": "^2.0.1",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "fflate": "^0.8.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
