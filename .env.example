# Optional: leave empty to run the laboratory in deterministic manual mode.
# Never share your API key or include .env.local in exported archives.
GEMINI_API_KEY=

# Local server port (change if 3000 is already in use).
PORT=3000

# Optional: Connect Gina to a Salesforce org in read-only / task-proposal mode.
# Without these values, the Salesforce tab runs in offline demonstration mode with synthetic data.
SALESFORCE_INSTANCE_URL=
SALESFORCE_ACCESS_TOKEN=

# Optional: HubSpot adapter, read-only (private app token with
# crm.objects.contacts.read + crm.objects.deals.read). Never commit the token.
HUBSPOT_ACCESS_TOKEN=

# Optional: Loopback interface bound by the local server. Defaults to 127.0.0.1 (local machine only).
# Never use 0.0.0.0: local API routes have no multi-tenant auth and must not be exposed on a shared network.
# HOST=127.0.0.1
