# Opcional: deixe vazio para usar o laboratório em modo manual.
# Nunca compartilhe sua chave ou inclua .env.local no ZIP.
GEMINI_API_KEY=

# Servidor local (altere se a porta estiver ocupada).
PORT=3000

# Opcional: Gina na Salesforce lendo a sua org (só leitura).
# Sem estes valores, a tela funciona em modo demonstração com dados fictícios.
SALESFORCE_INSTANCE_URL=
SALESFORCE_ACCESS_TOKEN=

# Opcional: interface em que o servidor escuta. Padrão 127.0.0.1 (só esta máquina).
# Não use 0.0.0.0: as rotas não têm autenticação e expõem a Salesforce a quem estiver na rede.
# HOST=127.0.0.1
